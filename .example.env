BOOKING_ENVIRONMENT=development              # Set to production for deployment
BOOKING_API_KEY=replace-with-a-random-secret  # Required for protected routes; 32+ chars in production
BOOKING_HOST=0.0.0.0
BOOKING_PORT=4040
BOOKING_MAX_CONCURRENT_SESSIONS=3
BOOKING_SESSION_TTL_SECONDS=1800
BOOKING_SESSION_REAP_INTERVAL_SECONDS=60
BOOKING_BOOKING_FILL_TIMEOUT_SECONDS=90
BOOKING_LOG_LEVEL=INFO
BOOKING_LOG_FILE=booking_api.log
BOOKING_CORS_ORIGINS=                         # Comma-separated explicit origins, e.g. https://booking.example.com
BOOKING_RATE_LIMIT_PER_MINUTE=20
BOOKING_TRUSTED_PROXY_CIDRS=                 # Only configure when a trusted proxy is in front of the API
BOOKING_DOCS_ENABLED=true                    # Must be false in production
# Staff routes require external OIDC role validation. No local staff login is supported.
BOOKING_USE_VIRTUAL_DISPLAY=true
BOOKING_ENABLE_VNC=false
BOOKING_VNC_PORT=5900
BOOKING_VNC_PASSWORD=
BOOKING_DEBUG_SCREENSHOTS=false

# One daily browsing refresh at 05:00 Europe/Dublin, next 30 days, both courses.
BOOKING_TEESHEET_DAYS=30
BOOKING_TEESHEET_REFRESH_HOUR=5
BOOKING_TEESHEET_REFRESH_ENABLED=true
BOOKING_INTENTS_COLLECTION=booking_intents

# Backend only. Never prefix a database URI with NEXT_PUBLIC_.
MONGODB_URI=
# Optional: overrides the URI database; defaults to rosapenna if neither is set.
MONGODB_DATABASE=
MONGODB_TIMEOUT_MS=5000
